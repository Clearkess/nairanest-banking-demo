# PostgreSQL connection string. Use a managed database with TLS in production.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/nairanest?sslmode=require"

# Generate with: openssl rand -base64 32
AUTH_SECRET="replace-with-a-long-random-secret"

# Application origin; set to the exact production domain.
APP_URL="http://localhost:3000"

# Provider credentials must be server-side only. Never expose with NEXT_PUBLIC_.
PAYMENT_PROVIDER_BASE_URL=""
PAYMENT_PROVIDER_SECRET=""
KYC_PROVIDER_BASE_URL=""
KYC_PROVIDER_SECRET=""
